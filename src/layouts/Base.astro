---
import '../styles/global.css';
import cards from '../../public/og/manifest.json';

export interface Props {
  title: string;
  description: string;
  /** Emit JSON-LD Person schema (home / bio pages). */
  personSchema?: boolean;
}

const {
  title,
  description,
  personSchema = false,
} = Astro.props;

const siteName = 'Munad Mahinoor';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/*
 * Social card: a 1200x630 PNG rendered from this page by
 * scripts/og/make-cards.mjs (the pre-commit hook keeps it current). Pages
 * without their own card, such as the 404, share the homepage's. The alt
 * text is the card's words, so a screen reader in a feed gets what a sighted
 * reader gets.
 */
type Card = { image: string; alt: string };
// Annotated, not asserted: the manifest's literal type has no index signature
// to look a route up in, and the assignment still checks every entry's shape.
const cardsByRoute: Record<string, Card> = cards;
const route = Astro.url.pathname.replace(/\/$/, '') || '/';
const card = cardsByRoute[route] ?? cardsByRoute['/'];
const ogImage = card ? new URL(card.image, Astro.site).href : undefined;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Munad Mahinoor',
  jobTitle: 'Senior Engineering Manager',
  description:
    'Engineering leader for AI-enabled, remote-first teams. Payments at scale.',
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Apply any stored theme override before first paint, so there is
         no flash of the wrong theme. Kept intentionally tiny — this is
         the only client-side JS that runs unconditionally on the site. */
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      card && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={card.alt} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      card && (
        <>
          <meta name="twitter:image" content={ogImage} />
          <meta name="twitter:image:alt" content={card.alt} />
        </>
      )
    }

    {
      personSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(personLd)}
        />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
