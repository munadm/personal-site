---
/*
 * AudioNarration — a native <audio> player for the AI-narrated reading of a
 * page. Renders nothing until `npm run audio` has generated the mp3 and
 * recorded it in public/audio/manifest.json, so a missing narration never
 * ships a broken player. The page itself is the transcript.
 *
 * Native <audio controls> is keyboard- and screen-reader-accessible for free;
 * the a11y suite (tests/a11y/audio.spec.ts) enforces the accessible name,
 * the visible "AI-narrated" label, and that the mp3 actually resolves.
 *
 * Read-along: while the narration plays, the paragraph being spoken is marked
 * with a rule in the left margin, so a reader can follow the voice through the
 * text. The manifest carries one cue (a start time in seconds) per narrated
 * block, measured from the mp3 itself by scripts/audio/cues.mjs, and
 * NARRATED_BLOCKS is the same selector the generator used to write the script.
 * The marker is visual only: it changes no text, no roles and no focus, so
 * the accessibility tree is identical whether or not it is showing, and it
 * never scrolls the page, which stays where the reader put it. Without
 * JavaScript the player works exactly as before, minus the marker.
 *
 * Readers choose: a switch turns the marker off for anyone who finds it
 * distracting, and a pair of radios picks its form, the rule in the margin or
 * a soft outline around the paragraph. Both are native controls, remembered
 * in localStorage like the theme, and rendered hidden so they only appear
 * when the script that honours them is running.
 *
 * The same cues drive the Media Session: a phone's lock screen, headphones
 * and car controls show the case study's title and its social card, and
 * their previous and next buttons move a paragraph at a time.
 * tests/a11y/read-along.spec.ts enforces all of that.
 */
import manifest from '../../public/audio/manifest.json';
import { NARRATED_BLOCKS } from '../lib/narration.mjs';

interface Props {
  /** Page slug — the manifest key and the /audio/<slug>.mp3 basename. */
  slug: string;
}

type Entry = { minutes: number; cues?: number[] };
// Annotated, not asserted: the manifest is generated with one entry per
// narrated slug, so its literal type has no index signature to look `slug` up
// in. The assignment keeps the check that every entry really carries minutes.
const entries: Record<string, Entry> = manifest;
const { slug } = Astro.props;
const entry = entries[slug];
const src = `/audio/${slug}.mp3`;
const label = entry ? `AI-narrated reading of this page, ${entry.minutes} minutes` : '';
const cues = entry?.cues ?? [];
const blocks = NARRATED_BLOCKS;
---

{
  entry && (
    <div class="narration">
      <p class="narration__head">
        <svg class="narration__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M4 9v6h3l5 4V5L7 9H4z"
            fill="currentColor"
          />
          <path
            d="M16 8.5a4 4 0 0 1 0 7M18.5 6a7.5 7.5 0 0 1 0 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
        <span class="narration__label">AI-narrated</span>
        <span class="narration__dot" aria-hidden="true">·</span>
        <span class="narration__meta">{entry.minutes} min</span>
      </p>
      <audio
        class="narration__player"
        controls
        preload="none"
        src={src}
        aria-label={label}
      />
      {
        cues.length > 0 && (
          <div class="read-along" hidden>
            <label class="read-along__switch">
              <input id="read-along-toggle" type="checkbox" role="switch" checked />
              Mark the paragraph being read
            </label>
            <fieldset class="read-along__style">
              <legend>Marker</legend>
              <label>
                <input type="radio" name="read-along-style" value="rule" checked />
                Margin rule
              </label>
              <label>
                <input type="radio" name="read-along-style" value="outline" />
                Outline
              </label>
            </fieldset>
          </div>
        )
      }
      <p class="narration__note">
        A synthetic voice reading the text on this page.{' '}
        <a href="/colophon">How it is made.</a>
      </p>
    </div>
  )
}

{
  cues.length > 0 && (
    <script is:inline define:vars={{ cues, blocks }}>
      (function () {
        var audio = document.querySelector('.narration__player');
        var panel = document.querySelector('.read-along');
        if (!audio || !panel) return;
        function load(key) {
          try { return localStorage.getItem(key); } catch (e) { return null; }
        }
        function save(key, value) {
          try { localStorage.setItem(key, value); } catch (e) {}
        }
        // This script sits above the body copy, so wait for the rest of the
        // page to parse before looking for its paragraphs.
        document.addEventListener('DOMContentLoaded', function () {
          var paragraphs = Array.prototype.filter.call(
            document.querySelectorAll(blocks),
            function (el) { return el.textContent.trim() !== ''; }
          );
          // Text edited since the audio was made: mark nothing rather than
          // the wrong paragraph, and leave the controls hidden since there is
          // nothing for them to control. The suite fails on this state.
          if (paragraphs.length !== cues.length) return;

          var toggle = document.getElementById('read-along-toggle');
          var styles = panel.querySelector('fieldset');
          var enabled = load('readAlong') !== 'off';
          var style = load('readAlongStyle') === 'outline' ? 'outline' : 'rule';
          var started = false;
          var current = -1;

          function mark(i) {
            if (i === current) return;
            if (current >= 0) paragraphs[current].removeAttribute('data-narrating');
            if (i >= 0) paragraphs[i].setAttribute('data-narrating', '');
            current = i;
          }
          function indexAt(t) {
            var i = cues.length - 1;
            while (i > 0 && cues[i] > t) i--;
            return i;
          }
          function follow() {
            mark(enabled && started ? indexAt(audio.currentTime) : -1);
          }
          function apply() {
            toggle.checked = enabled;
            styles.disabled = !enabled;
            panel.querySelector('input[value="' + style + '"]').checked = true;
            document.documentElement.setAttribute('data-read-along-style', style);
            follow();
          }

          toggle.addEventListener('change', function () {
            enabled = toggle.checked;
            save('readAlong', enabled ? 'on' : 'off');
            apply();
          });
          styles.addEventListener('change', function (event) {
            style = event.target.value;
            save('readAlongStyle', style);
            apply();
          });
          audio.addEventListener('play', function () { started = true; follow(); });
          audio.addEventListener('timeupdate', follow);
          audio.addEventListener('seeked', function () { started = true; follow(); });
          audio.addEventListener('ended', function () { started = false; follow(); });
          audio.addEventListener('emptied', function () { started = false; follow(); });
          apply();
          panel.hidden = false;

          // Lock screen, headphones and car: name the reading, and make the
          // previous and next buttons move by paragraph. This works whether
          // or not the marker is showing.
          if (!('mediaSession' in navigator)) return;
          var session = navigator.mediaSession;
          var card = document.querySelector('meta[property="og:image"]');
          function skip(step) {
            var here = indexAt(audio.currentTime);
            // As in any player, "previous" first restarts the current one.
            if (step < 0 && audio.currentTime - cues[here] > 3) step = 0;
            audio.currentTime = cues[Math.min(Math.max(here + step, 0), cues.length - 1)];
          }
          audio.addEventListener('play', function () {
            session.metadata = new MediaMetadata({
              title: paragraphs[0].textContent.trim(),
              artist: 'Munad Mahinoor',
              album: 'AI-narrated reading',
              artwork: card ? [{ src: card.content, sizes: '1200x630', type: 'image/png' }] : []
            });
            session.setActionHandler('previoustrack', function () { skip(-1); });
            session.setActionHandler('nexttrack', function () { skip(1); });
          });
        });
      })();
    </script>
  )
}

<style>
  .narration {
    max-width: var(--measure);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3) var(--space-3);
    border: var(--border-hair) solid var(--color-rule-faint);
    background: var(--color-surface);
  }

  .narration__head {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0 0 var(--space-2);
  }
  .narration__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--color-accent);
  }
  .narration__label {
    font-size: var(--fs-14);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .narration__meta {
    font-size: var(--fs-14);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  /* Decorative separator. A real aria-hidden element rather than CSS
     ::before content, which Chromium folds into the accessible name and
     some screen readers announce ("middle dot"). */
  .narration__dot {
    color: var(--color-rule-faint);
    user-select: none;
  }

  .narration__player {
    display: block;
    width: 100%;
    height: 40px;
  }
  .narration__player:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .narration__note {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-14);
    color: var(--color-muted);
  }

  /* Read-along settings: one switch and one pair of radios, native controls
     so keyboard, screen reader and forced colors all work without help.
     Each control's whole label is its hit area, well past the 24px target. */
  .read-along {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--fs-14);
  }
  .read-along[hidden] {
    display: none;
  }
  .read-along label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
    cursor: pointer;
  }
  .read-along__switch {
    font-weight: var(--fw-medium);
  }
  .read-along input {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .read-along__style {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  /* A floated legend sits inline with its options instead of on the border. */
  .read-along__style legend {
    float: left;
    padding: 0;
    color: var(--color-muted);
  }
  .read-along__style:disabled label,
  .read-along__style:disabled input {
    cursor: default;
  }

  /* Read-along marker: two vertical rules, a hairline and a bold one, set in
     the margin beside the paragraph being spoken. It is the site's rule
     motif turned on its side, and it sits in the container's side padding
     rather than behind the text, so nothing is ever drawn under words.
     Absolutely positioned, so marking a paragraph cannot shift a single line
     of layout, and it switches instantly with no transition. */
  :global([data-narrating]) {
    position: relative;
  }
  :global([data-narrating])::before {
    content: '';
    position: absolute;
    inset-block: 0.2em;
    inset-inline-start: calc(-1 * var(--space-2) - 2px);
    width: 7px;
    background: linear-gradient(
      to right,
      var(--color-accent-graphic) 0 1px,
      transparent 1px 3px,
      var(--color-accent-graphic) 3px 7px
    );
  }
  /* Forced colors strips gradients, which would erase the marker. Opt the
     marker alone out and paint it in the user's own Highlight color. */
  @media (forced-colors: active) {
    :global([data-narrating])::before {
      forced-color-adjust: none;
      background: linear-gradient(
        to right,
        Highlight 0 1px,
        transparent 1px 3px,
        Highlight 3px 7px
      );
    }
  }

  /* Outline variant: a soft rounded outline around the whole paragraph in
     place of the margin rule. An outline takes no layout space, so this
     cannot move a line either, and it stays clear of the text: the offset
     sits in the side padding and inside the gap between paragraphs. The
     colour is the soft accent, 3:1 or better against the page in both
     themes. Distinct from the focus ring, which is 3px of solid ink. */
  :global([data-read-along-style='outline'] [data-narrating])::before {
    display: none;
  }
  :global([data-read-along-style='outline'] [data-narrating]) {
    outline: 2px solid var(--color-accent-soft);
    outline-offset: 10px;
    border-radius: 10px;
  }
  @media (forced-colors: active) {
    :global([data-read-along-style='outline'] [data-narrating]) {
      outline-color: Highlight;
    }
  }

  @media print {
    :global([data-narrating])::before {
      display: none;
    }
    :global([data-narrating]) {
      outline: none;
    }
  }
</style>
